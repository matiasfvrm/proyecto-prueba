# Copy to .env.local and fill in what you need. Every variable is optional:
# with nothing set, UNsolved runs in demo mode (browser-only persistence).

# Public URL of the deployment (used for metadata and the sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Repository link shown in the footer (AGPL §13: users must be able to get the source).
NEXT_PUBLIC_REPO_URL=https://github.com/matiasfvrm/proyecto-prueba

# ── Supabase (enables shared persistence and email sign-in) ──
# Both public values are safe in the browser; Row Level Security protects the data.
# Never put the service-role key in any NEXT_PUBLIC_ variable. The app does not need it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AI assistance (optional, server-only) ──
# Enables the "Check my draft" assistant on the submit form. Without it, a
# rule-based checklist is used and the UI says so.
ANTHROPIC_API_KEY=
# Optional model override (defaults to claude-opus-5-5).
ANTHROPIC_MODEL=
